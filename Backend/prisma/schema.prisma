generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  engineType    = "library"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(uuid())
  fullName      String
  city          String
  district      String
  email         String          @unique
  password      String
  role          String          @default("USER")
  profileType   String?
  employeeType  String?
  
  // Şifre sıfırlama için alanlar
  resetCode       String?
  resetCodeExpiry DateTime?

  regionId      String?
  region        Region?         @relation(fields: [regionId], references: [id])
  wasteRequests WasteRequest[]
  collections   CollectionLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Region {
  id        String   @id @default(uuid())
  name      String   @unique
  users     User[]
  bins      Bin[]
  createdAt DateTime @default(now())
}

model Bin {
  id                String          @id @default(uuid())
  type              String
  wasteCategory     String          @default("GENERAL")
  latitude          Float
  longitude         Float
  capacityVolume    Float
  predictedFullness Float           @default(0.0)
  regionId          String
  region            Region          @relation(fields: [regionId], references: [id])
  logs              CollectionLog[]
  createdAt         DateTime        @default(now())
}

model CollectionLog {
  id             String   @id @default(uuid())
  binId          String
  bin            Bin      @relation(fields: [binId], references: [id])
  employeeId     String
  employee       User     @relation(fields: [employeeId], references: [id])
  emptiedAt      DateTime @default(now())
  actualFullness Float
}

model WasteRequest {
  id                 String        @id @default(uuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id])
  wasteType          String
  note               String?
  latitude           Float
  longitude          Float
  status             String        @default("PENDING")
  assignedEmployeeId String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}
