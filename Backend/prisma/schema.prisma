generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  engineType    = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
  USER
  BOSS
}

enum EmployeeType {
  TRASH_COLLECTOR
  WASTE_COLLECTOR
}

enum BinType {
  CONTAINER_LARGE
  CONTAINER_SMALL
  WASTE_POINT
}

enum WasteCategory {
  DOMESTIC
  ELECTRONIC
  PLASTIC
  GLASS
  PAPER
  GENERAL
}

enum RequestStatus {
  PENDING
  ON_ROUTE
  COLLECTED
  CANCELLED
}

enum TransactionType {
  EARNED
  SPENT
  REFUNDED
}

model User {
  id                String             @id @default(uuid())
  name              String
  surname           String?
  email             String             @unique
  password          String
  phoneNumber       String             @unique @db.VarChar(10)
  role              Role               @default(USER)
  employeeType      EmployeeType?
  city              String?
  district          String?
  regionId          String?
  region            Region?            @relation(fields: [regionId], references: [id])
  wasteRequests     WasteRequest[]
  collections       CollectionLog[]
  wallet            Wallet?
  transactions      Transaction[]
  redemptions       Redemption[]
  isVerified        Boolean            @default(false)
  profileImage      String?            @db.Text
  profileType       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  refreshTokens     RefreshToken[]
  verificationCodes VerificationCode[]
  resetTokens       ResetToken[]
  scannedQRCodes    ScannedQRCode[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  revorked  Boolean  @default(false)
  expiredAt DateTime
  createdAt DateTime @default(now())
}

model VerificationCode {
  id          String   @id @default(uuid())
  code        String
  userId      String   @unique
  targetEmail String?  // Kodun hangi mail için üretildiğini takip etmek için
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  expiredAt   DateTime
}

model ResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiredAt DateTime
  createdAt DateTime @default(now())
}

model Wallet {
  id        String   @id @default(uuid())
  balance   Int      @default(0)
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  updatedAt DateTime @updatedAt
}

model Transaction {
  id          String          @id @default(uuid())
  amount      Int
  type        TransactionType
  description String?
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  createdAt   DateTime        @default(now())
}

model Reward {
  id          String       @id @default(uuid())
  title       String
  description String
  coinCost    Int
  stock       Int          @default(100)
  redemptions Redemption[]
  createdAt   DateTime     @default(now())
}

model Redemption {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rewardId  String
  reward    Reward   @relation(fields: [rewardId], references: [id])
  code      String   @unique // Kullanıcının kasada göstereceği dijital kod
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Region {
  id        String   @id @default(uuid())
  name      String   @unique
  region_id String
  users     User[]
  bins      Bin[]
  createdAt DateTime @default(now())
}

model Bin {
  id                String          @id @default(uuid())
  name              String?         @db.Text
  type              BinType
  wasteCategory     WasteCategory   @default(GENERAL)
  latitude          Float
  longitude         Float
  capacityVolume    Float           @default(100.0)
  predictedFullness Float           @default(0.0)
  regionId          String?
  region            Region?         @relation(fields: [regionId], references: [id])
  logs              CollectionLog[]
  createdAt         DateTime        @default(now())
}

model CollectionLog {
  id             String   @id @default(uuid())
  binId          String
  bin            Bin      @relation(fields: [binId], references: [id])
  employeeId     String
  employee       User     @relation(fields: [employeeId], references: [id])
  emptiedAt      DateTime @default(now())
  actualFullness Float

  @@index([binId, emptiedAt(sort: Desc)])
}

model WasteRequest {
  id                 String        @id @default(uuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id])
  wasteType          WasteCategory
  note               String?
  latitude           Float
  longitude          Float
  status             RequestStatus @default(PENDING)
  assignedEmployeeId String?
  weight             Float?
  earnedCoins        Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScannedQRCode {
  id          String   @id @default(uuid())
  code        String   @unique // The unique content of the QR code
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  coinsEarned Int
  createdAt   DateTime @default(now())
}
