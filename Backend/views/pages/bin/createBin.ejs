<%- include('../../layout/header') %>

<div id="region-banner" class="alert alert-warning mb-2" style="display:none;" role="alert"></div>

<div id="bin-panel" style="display:none; position: absolute; top: 20px; right: 20px; z-index: 1000; background: #FCFAF8; padding: 20px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.15); width: 300px; font-family: sans-serif;">
    <h5 id="panel-title" style="margin-top:0;">Yeni çöp kovası</h5>

    <label>Koordinatlar</label>
    <div style="display:flex; gap:5px; margin-bottom:10px;">
        <input type="text" id="lat-input" readonly style="width:50%; font-size:11px; padding:5px; background:#eee; border:1px solid #ccc;">
        <input type="text" id="lng-input" readonly style="width:50%; font-size:11px; padding:5px; background:#eee; border:1px solid #ccc;">
    </div>

    <label>Bölge (parsel)</label>
    <input type="text" id="region-display" readonly style="width:100%; font-size:12px; padding:5px; margin-bottom:10px; background:#e9ecef; border:1px solid #ced4da; font-weight:bold;">

    <label>Kova türü</label>
    <select id="bin-type" class="form-select mb-2">
        <option value="CONTAINER_LARGE">Büyük konteyner</option>
        <option value="CONTAINER_SMALL">Küçük konteyner</option>
        <option value="WASTE_POINT">Atık noktası</option>
    </select>

    <label>Atık kategorisi</label>
    <select id="waste-category" class="form-select mb-2">
        <option value="GENERAL">Genel (GENERAL)</option>
        <option value="DOMESTIC">Evsel (DOMESTIC)</option>
        <option value="ELECTRONIC">Elektronik (ELECTRONIC)</option>
        <option value="PLASTIC">Plastik (PLASTIC)</option>
        <option value="GLASS">Cam (GLASS)</option>
        <option value="PAPER">Kağıt (PAPER)</option>
    </select>

    <label>Kapasite (litre)</label>
    <input type="number" id="capacity" class="form-control mb-2" value="100" min="1" step="1">

    <div id="panel-error" class="text-danger small mb-2" style="display:none;"></div>

    <div style="display:flex; flex-wrap:wrap; gap:8px;">
        <button type="button" onclick="saveBin()" class="btn btn-success btn-sm">Kaydet</button>
        <button type="button" id="btn-delete-bin" onclick="deleteSelectedBin()" class="btn btn-outline-danger btn-sm" style="display:none;">Sil</button>
        <button type="button" onclick="cancelPanel()" class="btn btn-secondary btn-sm">İptal</button>
    </div>
    <p class="small text-muted mt-2 mb-0">Kayıt için <strong>ADMIN</strong> veya <strong>BOSS</strong> oturumu gerekir.</p>
</div>

<div class="mb-2">
    <button type="button" class="btn btn-sm btn-primary" onclick="startAddMode()">Yeni kova ekle</button>
</div>

<div id="map" style="height: 600px; width: 100%;"></div>

<div class="map-bin-legend d-flex flex-wrap gap-3 align-items-center mt-2 mb-3" id="map-bin-legend"></div>

<style>
  .map-bin-legend { font-size: 0.875rem; }
  .map-bin-legend__group { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; }
  .map-bin-legend__item { display: inline-flex; align-items: center; gap: 0.35rem; }
  .map-bin-legend__item img { width: 20px; height: 20px; object-fit: contain; }
  .leaflet-marker-icon { image-rendering: -webkit-optimize-contrast; image-rendering: crisp-edges; }
</style>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link rel="stylesheet" href="/assets/css/map-pin-marker.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="/assets/js/map/binMapIcons.js"></script>
<script src="https://unpkg.com/@mapbox/leaflet-pip@latest/leaflet-pip.js"></script>

<script>
  const map = L.map('map').setView([38.459, 27.228], 15);
  const fetchOpts = { credentials: 'include' };

  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; OpenStreetMap'
  }).addTo(map);

  const MAP_ICON_OPTS = { baseZoom: 15, baseSize: 22 };

  function renderMapLegend() {
    const el = document.getElementById('map-bin-legend');
    if (!el) return;
    el.innerHTML = renderMapLegendHtml();
  }

  function getSelectedBinType() {
    return document.getElementById('bin-type').value;
  }

  function getSelectedWasteCategory() {
    return document.getElementById('waste-category').value;
  }

  function markerIconOptions(binOrType, wasteCategory) {
    if (binOrType && typeof binOrType === 'object') {
      return { ...MAP_ICON_OPTS, wasteCategory: binOrType.wasteCategory };
    }
    return { ...MAP_ICON_OPTS, wasteCategory: wasteCategory || getSelectedWasteCategory() };
  }

  function refreshMarkerIcon(marker, binType, wasteCategory) {
    if (!marker) return;
    const type = binType || getSelectedBinType();
    const category = wasteCategory != null ? wasteCategory : getSelectedWasteCategory();
    marker.setIcon(getBinIcon(type, map.getZoom(), markerIconOptions(type, category)));
    marker.binType = type;
    marker.binWasteCategory = category;
  }

  let tempMarker = null;
  let campusLayer = null;
  let detectedParcelKey = null;
  let binMarkersLayer = L.layerGroup().addTo(map);
  let editMarker = null;
  let panelMode = 'idle';
  let editingBinId = null;

  function showPanelError(msg) {
    const el = document.getElementById('panel-error');
    el.textContent = msg || '';
    el.style.display = msg ? 'block' : 'none';
  }

  async function loadCampusAreas() {
    try {
      const response = await fetch('/api/regions/static', fetchOpts);
      const result = await response.json();
      const geojsonData = result.features ? result : result.data;
      if (!geojsonData) {
        console.error('GeoJSON verisi bulunamadı.');
        return;
      }
      if (campusLayer) map.removeLayer(campusLayer);
      campusLayer = L.geoJSON(geojsonData, {
        style: { color: '#ff7800', weight: 2, fillOpacity: 0.1 }
      }).addTo(map);
      map.fitBounds(campusLayer.getBounds());
    } catch (err) {
      console.error(err);
    }
  }

  async function checkRegionsInDb() {
    const banner = document.getElementById('region-banner');
    try {
      const res = await fetch('/api/regions/get/g', fetchOpts);
      const json = await res.json();
      const list = (json.region || []).map(r => r.region_id);
      const need = ['akademik', 'hastane', 'kyk'];
      const missing = need.filter(k => !list.includes(k));
      if (missing.length) {
        banner.style.display = 'block';
        banner.innerHTML = 'Veritabanında eksik parsel kayıtları: <code>' + missing.join(', ') +
          '</code>. <a href="/region/create">Bölge ekle</a> sayfasından <code>region_id</code> bu değerlerle eşleşmeli.';
      } else {
        banner.style.display = 'none';
      }
    } catch (e) {
      console.warn(e);
    }
  }

  function getRegionAt(lat, lng) {
    if (!campusLayer || !window.leafletPip) return null;
    const match = leafletPip.pointInLayer([lng, lat], campusLayer);
    if (match && match.length > 0) {
      return {
        id: match[0].feature.id,
        name: match[0].feature.properties.name
      };
    }
    return null;
  }

  async function loadExistingBins() {
    binMarkersLayer.clearLayers();
    try {
      const res = await fetch('/api/bins', fetchOpts);
      if (!res.ok) return;
      const bins = await res.json();
      bins.forEach((bin) => {
        const m = L.marker([bin.latitude, bin.longitude], {
          icon: getBinIcon(bin.type, map.getZoom(), markerIconOptions(bin)),
          draggable: false,
        });
        m.binRecord = bin;
        m.binType = bin.type;
        m.binWasteCategory = bin.wasteCategory;
        const fullnessPct = Math.round((bin.predictedFullness || 0) * 100);
        m.bindPopup(
          '<strong>' + (bin.region && bin.region.name ? bin.region.name : 'Bölge') + '</strong><br>' +
          getBinTypeLabel(bin.type, bin.wasteCategory) + '<br>' +
          '<small>Doluluk: %' + fullnessPct + '</small>'
        );
        m.on('click', (e) => {
          L.DomEvent.stopPropagation(e);
          openEditPanel(bin);
        });
        m.addTo(binMarkersLayer);
      });
    } catch (e) {
      console.error(e);
    }
  }

  function applyWasteCategoryRules() {
    const binType = document.getElementById('bin-type');
    const wasteCat = document.getElementById('waste-category');
    if (binType.value !== 'WASTE_POINT') {
      wasteCat.value = 'GENERAL';
      Array.from(wasteCat.options).forEach(o => { o.disabled = (o.value !== 'GENERAL'); });
    } else {
      Array.from(wasteCat.options).forEach(o => { o.disabled = false; });
    }
  }

  document.getElementById('bin-type').onchange = function () {
    applyWasteCategoryRules();
    if (tempMarker) refreshMarkerIcon(tempMarker);
    if (editMarker) refreshMarkerIcon(editMarker);
  };

  document.getElementById('waste-category').onchange = function () {
    if (getSelectedBinType() !== 'WASTE_POINT') return;
    if (tempMarker) refreshMarkerIcon(tempMarker);
    if (editMarker) refreshMarkerIcon(editMarker);
  };

  map.on('zoomend', function () {
    const zoom = map.getZoom();
    binMarkersLayer.eachLayer((layer) => {
      if (layer instanceof L.Marker && layer.binType) {
        layer.setIcon(
          getBinIcon(layer.binType, zoom, {
            ...MAP_ICON_OPTS,
            wasteCategory: layer.binWasteCategory,
          })
        );
      }
    });
    if (tempMarker && tempMarker.binType) {
      tempMarker.setIcon(
        getBinIcon(tempMarker.binType, zoom, {
          ...MAP_ICON_OPTS,
          wasteCategory: tempMarker.binWasteCategory,
        })
      );
    }
    if (editMarker && editMarker.binType) {
      editMarker.setIcon(
        getBinIcon(editMarker.binType, zoom, {
          ...MAP_ICON_OPTS,
          wasteCategory: editMarker.binWasteCategory,
        })
      );
    }
  });

  function startAddMode() {
    cancelPanel();
    panelMode = 'add';
    document.getElementById('panel-title').textContent = 'Yeni çöp kovası';
    document.getElementById('btn-delete-bin').style.display = 'none';
    showPanelError('');
  }

  function cancelPanel() {
    if (tempMarker) {
      map.removeLayer(tempMarker);
      tempMarker = null;
    }
    if (editMarker) {
      map.removeLayer(editMarker);
      editMarker = null;
    }
    document.getElementById('bin-panel').style.display = 'none';
    detectedParcelKey = null;
    editingBinId = null;
    panelMode = 'idle';
    showPanelError('');
  }

  function openEditPanel(bin) {
    if (tempMarker) {
      map.removeLayer(tempMarker);
      tempMarker = null;
    }
    panelMode = 'edit';
    editingBinId = bin.id;
    document.getElementById('panel-title').textContent = 'Çöp kovasını düzenle';
    document.getElementById('btn-delete-bin').style.display = 'inline-block';
    detectedParcelKey = bin.region ? bin.region.region_id : null;
    document.getElementById('region-display').value = bin.region ? bin.region.name : '';
    document.getElementById('lat-input').value = Number(bin.latitude).toFixed(6);
    document.getElementById('lng-input').value = Number(bin.longitude).toFixed(6);
    document.getElementById('bin-type').value = bin.type;
    document.getElementById('waste-category').value = bin.wasteCategory;
    document.getElementById('capacity').value = bin.capacityVolume;

    applyWasteCategoryRules();

    if (editMarker) map.removeLayer(editMarker);
    editMarker = L.marker([bin.latitude, bin.longitude], {
      icon: getBinIcon(bin.type, map.getZoom(), markerIconOptions(bin)),
      draggable: true,
    }).addTo(map);
    editMarker.binType = bin.type;
    editMarker.binWasteCategory = bin.wasteCategory;
    editMarker.on('dragend', () => {
      const ll = editMarker.getLatLng();
      document.getElementById('lat-input').value = ll.lat.toFixed(6);
      document.getElementById('lng-input').value = ll.lng.toFixed(6);
      const region = getRegionAt(ll.lat, ll.lng);
      if (!region) {
        showPanelError('İşaretçi bir parsel dışına taşındı.');
        return;
      }
      showPanelError('');
      detectedParcelKey = region.id;
      document.getElementById('region-display').value = region.name;
    });

    document.getElementById('bin-panel').style.display = 'block';
  }

  map.on('click', function (e) {
    if (panelMode !== 'add') return;
    const region = getRegionAt(e.latlng.lat, e.latlng.lng);
    if (!region) {
      alert('Lütfen turuncu parsel alanının içine tıklayın.');
      return;
    }
    detectedParcelKey = region.id;
    document.getElementById('region-display').value = region.name;
    document.getElementById('lat-input').value = e.latlng.lat.toFixed(6);
    document.getElementById('lng-input').value = e.latlng.lng.toFixed(6);
    if (tempMarker) {
      tempMarker.setLatLng(e.latlng);
    } else {
      tempMarker = L.marker(e.latlng, {
        draggable: true,
        icon: getBinIcon(
          getSelectedBinType(),
          map.getZoom(),
          markerIconOptions(getSelectedBinType(), getSelectedWasteCategory())
        ),
      }).addTo(map);
      tempMarker.binType = getSelectedBinType();
      tempMarker.binWasteCategory = getSelectedWasteCategory();
      tempMarker.on('dragend', () => {
        const ll = tempMarker.getLatLng();
        document.getElementById('lat-input').value = ll.lat.toFixed(6);
        document.getElementById('lng-input').value = ll.lng.toFixed(6);
        const r = getRegionAt(ll.lat, ll.lng);
        if (!r) {
          showPanelError('İşaretçi parsel dışında.');
          return;
        }
        showPanelError('');
        detectedParcelKey = r.id;
        document.getElementById('region-display').value = r.name;
      });
    }
    document.getElementById('bin-panel').style.display = 'block';
  });

  async function parseError(res) {
    try {
      const j = await res.json();
      return j.message || JSON.stringify(j);
    } catch {
      return res.statusText || 'İstek başarısız';
    }
  }

  async function saveBin() {
    showPanelError('');
    const lat = parseFloat(document.getElementById('lat-input').value);
    const lng = parseFloat(document.getElementById('lng-input').value);
    const wasteCategory = document.getElementById('waste-category').value;
    const type = document.getElementById('bin-type').value;
    const capacityVolume = parseFloat(document.getElementById('capacity').value);
    if (!detectedParcelKey) {
      showPanelError('Parsel seçilemedi.');
      return;
    }
    const body = {
      latitude: lat,
      longitude: lng,
      wasteCategory,
      type,
      capacityVolume,
      regionId: detectedParcelKey
    };

    try {
      if (panelMode === 'edit' && editingBinId) {
        const res = await fetch('/api/bins/' + editingBinId, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          ...fetchOpts,
          body: JSON.stringify(body)
        });
        if (!res.ok) {
          showPanelError(await parseError(res));
          return;
        }
        alert('Güncellendi.');
        cancelPanel();
        await loadExistingBins();
        return;
      }

      const res = await fetch('/api/bins', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        ...fetchOpts,
        body: JSON.stringify(body)
      });
      if (!res.ok) {
        showPanelError(await parseError(res));
        return;
      }
      alert('Kaydedildi.');
      cancelPanel();
      await loadExistingBins();
    } catch (e) {
      console.error(e);
      showPanelError('Ağ hatası.');
    }
  }

  async function deleteSelectedBin() {
    if (!editingBinId) return;
    if (!confirm('Bu çöp kovasını silmek istediğinize emin misiniz?')) return;
    try {
      const res = await fetch('/api/bins/' + editingBinId, { method: 'DELETE', ...fetchOpts });
      if (!res.ok) {
        alert(await parseError(res));
        return;
      }
      alert('Silindi.');
      cancelPanel();
      await loadExistingBins();
    } catch (e) {
      console.error(e);
      alert('Silinemedi.');
    }
  }

  window.onload = async () => {
    renderMapLegend();
    await loadCampusAreas();
    await checkRegionsInDb();
    await loadExistingBins();
    applyWasteCategoryRules();
    startAddMode();
  };
</script>

<%- include('../../layout/footer') %>
