<!DOCTYPE html>
<html>
<head>
    <title>Bornova Haritası</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        #map { height: 600px; width: 100%; border: 2px solid #ccc; }
    </style>
</head>
<body>
<h1>Bornova İlçe Sınırları</h1>
<div id="map"></div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
  // 1. Haritayı Bornova merkezli başlat
  const map = L.map('map').setView([38.46, 27.21], 12);

  // 2. OpenStreetMap katmanını ekle
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© OpenStreetMap contributors'
  }).addTo(map);

  fetch('/api/regions')
      .then(response => response.json())
      .then(result => {

        const bornovaLayer = L.geoJSON(result.data, {
          style: {
            color: "#ff7800",
            weight: 3,
            opacity: 0.65,
            fillColor: "#ff7800",
            fillOpacity: 0.1
          }
        }).addTo(map);

        if (result.data) {
          map.fitBounds(bornovaLayer.getBounds());
        }
      })
      .catch(error => console.error('GeoJSON yüklenirken hata:', error));
</script>
</body>
</html>