<%- include('../../layout/header') %>

<div class="container">
    <div class="row mb-8">
        <div class="col-xl-4 offset-xl-4 col-md-12 col-12">
            <div class="text-center">
                <a href="/dashboard" class="fs-2 fw-bold d-flex align-items-center gap-2 justify-content-center mb-6">
                    <img src="/assets/images/brand/logo/logo-icon.svg" alt="" />
                    <span>Dasher</span>
                </a>
                <h1 class="mb-1">Bölge Ekleme</h1>

            </div>
        </div>
    </div>
    <div class="row justify-content-center">
        <div class="col-xl-5 col-lg-6 col-md-8 col-12">
            <div class="card card-lg mb-6">
                <div class="card-body p-6">
                    <form id="regionForm" class="needs-validation mb-6" novalidate>
                        <div class="mb-3">
                            <label for="signinEmailInput" class="form-label">
                                Bölge Adı
                                <span class="text-danger">*</span>
                            </label>
                            <input type="text" name="name" class="form-control" id="signinEmailInput" required />
                            <div class="invalid-feedback">Lütfen bölge adı giriniz!</div>
                        </div>
                        <div class="mb-3">
                            <label for="regionId" class="form-label">Bölge Id <span class="text-danger">*</span></label>
                            <div class="password-field position-relative">
                                <input name="region_id" type="text" class="form-control fakePassword" id="regionId" required />
                                <div class="invalid-feedback">Lütfen bölge id'si giriniz!</div>
                            </div>
                        </div>

                        <div class="d-grid">
                            <button class="btn btn-primary" type="submit">Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('regionForm').addEventListener('submit', async (e) => {
      e.preventDefault()

      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData.entries());

      try {
        const response = await fetch('/api/regions/create', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(data)
        })
        console.log(response)
      }catch (err) {

      }


    })
</script>


<%- include('../../layout/footer') %>