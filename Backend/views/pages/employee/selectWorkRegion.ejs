<%- include('../../layout/header') %>

<div class="row mb-6 mt-3">
  <div class="col-12">
    <h1 class="fs-3 mb-2">Çalışma bölgesi seç</h1>
    <p class="text-secondary mb-0">
      Görev alanınızı belirleyin. Seçtiğiniz bölge hesabınıza kaydedilir ve atık toplama işlerinizde referans olarak kullanılır.
    </p>
  </div>
</div>

<div class="row justify-content-center mt-4">
  <div class="col-xl-6 col-lg-8 col-12">
    <div class="card card-lg">
      <div class="card-body p-6">
        <div id="statusMessage" class="alert d-none mb-4" role="alert"></div>

        <% if (selectedRegionName) { %>
          <p class="mb-4">
            <span class="text-secondary">Mevcut çalışma bölgeniz:</span>
            <strong class="ms-1"><%= selectedRegionName %></strong>
          </p>
        <% } else { %>
          <p class="text-secondary mb-4">Henüz bir çalışma bölgesi seçmediniz.</p>
        <% } %>

        <form id="workRegionForm" class="needs-validation" novalidate>
          <div class="mb-4">
            <label for="workRegionSelect" class="form-label">
              Bölge <span class="text-danger">*</span>
            </label>
            <select id="workRegionSelect" name="regionId" class="form-select" required>
              <option value="" disabled <%= !selectedRegionId ? 'selected' : '' %>>Bölge seçiniz</option>
              <% regions.forEach(function (item) { %>
                <option value="<%= item.id %>" <%= selectedRegionId === item.id ? 'selected' : '' %>>
                  <%= item.name %>
                </option>
              <% }); %>
            </select>
            <div class="invalid-feedback">Lütfen bir bölge seçiniz.</div>
          </div>

          <div class="d-grid">
            <button type="submit" class="btn btn-primary" id="saveBtn">Kaydet</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  const form = document.getElementById('workRegionForm');
  const statusEl = document.getElementById('statusMessage');
  const saveBtn = document.getElementById('saveBtn');

  function showStatus(message, type) {
    statusEl.textContent = message;
    statusEl.className = 'alert alert-' + type + ' mb-4';
    statusEl.classList.remove('d-none');
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    e.stopPropagation();

    if (!form.checkValidity()) {
      form.classList.add('was-validated');
      return;
    }

    const regionId = document.getElementById('workRegionSelect').value;
    saveBtn.disabled = true;

    try {
      const response = await fetch('/api/users/me/work-region', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ regionId }),
      });

      const result = await response.json();

      if (!response.ok) {
        showStatus(result.message || 'Kayıt başarısız.', 'danger');
        return;
      }

      showStatus(result.message || 'Çalışma bölgeniz kaydedildi.', 'success');
      setTimeout(() => location.reload(), 800);
    } catch (err) {
      showStatus('Bağlantı hatası. Lütfen tekrar deneyin.', 'danger');
    } finally {
      saveBtn.disabled = false;
    }
  });
</script>

<%- include('../../layout/footer') %>
