<%- include('../../layout/header') %>

<div class="row mb-3 mt-3">
  <div class="col-12">
    <h1 class="fs-3 mb-2">Geri dönüşümüm</h1>
    <p class="text-secondary mb-0">
      Geri dönüştürdüğünüz atık miktarı burada görünecek. Bu alan şimdilik hazırlanıyor; ileride talep ve toplama kayıtlarınızla doldurulacak.
    </p>
  </div>
</div>

<div class="row mb-4">
  <div class="col-12 col-lg-6">
    <div class="card card-lg">
      <div class="card-body p-6 text-center">
        <div class="icon-shape icon-xl rounded-circle bg-success-darker d-inline-flex align-items-center justify-content-center mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
            class="icon icon-tabler icons-tabler-outline icon-tabler-recycle text-success-lighter">
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M12 17l-2 2m2 -2l2 2m-2 -2v-5" />
            <path d="M16.5 7.5l-2.5 -2.5l2.5 -2.5" />
            <path d="M7.5 7.5l2.5 -2.5l-2.5 -2.5" />
            <path d="M7 12a5 5 0 0 1 5 -5h3" />
            <path d="M17 12a5 5 0 0 1 -5 5h-3" />
          </svg>
        </div>
        <p class="text-secondary small mb-2">Toplam geri dönüştürülen</p>
        <p class="fs-1 fw-bold mb-2">—</p>
        <p class="text-secondary small mb-0">Henüz kayıt yok</p>
      </div>
    </div>
  </div>
</div>

<div class="row mb-2">
  <div class="col-12">
    <h2 class="fs-5 mb-0">Kategori bazında</h2>
    <p class="text-secondary small mb-0">Yakında: plastik, cam, kağıt ve diğer atık türleriniz</p>
  </div>
</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4 mb-6">
  <% const categories = [
    { label: 'Evsel atık', icon: '/assets/images/map/waste-domestic.svg' },
    { label: 'Plastik', icon: '/assets/images/map/waste-plastic.svg' },
    { label: 'Cam', icon: '/assets/images/map/waste-glass.svg' },
    { label: 'Kağıt', icon: '/assets/images/map/waste-paper.svg' },
    { label: 'Elektronik', icon: '/assets/images/map/waste-electronic.svg' },
    { label: 'Genel', icon: '/assets/images/map/waste-general.svg' },
  ]; %>
  <% categories.forEach(function(cat) { %>
  <div class="col">
    <div class="card card-lg h-100 opacity-75">
      <div class="card-body d-flex align-items-center gap-3">
        <img src="<%= cat.icon %>" alt="" width="32" height="32" style="object-fit: contain;">
        <div>
          <div class="small fw-semibold"><%= cat.label %></div>
          <div class="fs-5 fw-bold mb-0 text-secondary">0 L</div>
        </div>
      </div>
    </div>
  </div>
  <% }); %>
</div>

<%- include('../../layout/footer') %>

