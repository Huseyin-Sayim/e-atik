<%- include('../../layout/header') %>

<div class="row mb-3 mt-3">
  <div class="col-12">
    <h1 class="fs-3 mb-2">Geri dönüşümüm</h1>
    <p class="text-secondary mb-0">
      Atık çeşitlerini geri dönüştürdüğünüzde kazanacağınız coin miktarları aşağıdadır.
    </p>
  </div>
</div>

<div class="row mb-4">
  <div class="col-12 col-lg-6">
    <div class="card card-lg">
      <div class="card-body p-6 text-center">
        <div class="icon-shape icon-xl rounded-circle bg-success-darker d-inline-flex align-items-center justify-content-center mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
            class="icon icon-tabler icons-tabler-outline icon-tabler-coins text-success-lighter">
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M9 14c0 1.657 2.686 3 6 3s6 -1.343 6 -3s-2.686 -3 -6 -3s-6 1.343 -6 3z" />
            <path d="M9 14v4c0 1.657 2.686 3 6 3s6 -1.343 6 -3v-4" />
          </svg>
        </div>
        <p class="text-secondary small mb-2">Cüzdan bakiyeniz</p>
        <p class="fs-1 fw-bold mb-2" id="my-wallet-balance">—</p>
        <p class="text-secondary small mb-0" id="my-wallet-sub">Yükleniyor…</p>
      </div>
    </div>
  </div>
</div>

<div class="row mb-2">
  <div class="col-12">
    <h2 class="fs-5 mb-0">Atık çeşitleri ve coin ödülleri</h2>
    <p class="text-secondary small mb-0">Ana kategori altındaki her çeşit için kazanılacak coin</p>
  </div>
</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4 mb-6" id="recycling-types-grid">
  <div class="col-12 text-secondary text-center py-4">Yükleniyor…</div>
</div>

<script>
  (function () {
    function coinBadge(type) {
      if (type.coinRewardMode === 'PER_KG') {
        return type.coinRewardValue + ' coin / kg';
      }
      return type.coinRewardValue + ' coin';
    }

    async function loadWallet() {
      const balanceEl = document.getElementById('my-wallet-balance');
      const subEl = document.getElementById('my-wallet-sub');
      try {
        const res = await fetch('/api/wallet/me', { credentials: 'same-origin' });
        const body = await res.json().catch(function () {
          return {};
        });
        if (!res.ok) throw new Error();
        balanceEl.textContent = (body.data?.balance ?? 0).toLocaleString('tr-TR');
        subEl.textContent = 'Toplanan atıklardan kazanılan coinler';
      } catch {
        balanceEl.textContent = '0';
        subEl.textContent = 'Bakiye alınamadı';
      }
    }

    async function loadTypes() {
      const grid = document.getElementById('recycling-types-grid');
      try {
        const res = await fetch('/api/waste-types');
        const body = await res.json().catch(function () {
          return {};
        });
        if (!res.ok) throw new Error(body.message || 'Liste alınamadı');
        const tree = body.data || [];
        const cards = [];
        tree.forEach(function (parent) {
          (parent.children || []).forEach(function (child) {
            cards.push(
              '<div class="col">' +
              '<div class="card card-lg h-100">' +
              '<div class="card-body">' +
              '<div class="text-secondary small mb-1">' +
              parent.name +
              '</div>' +
              '<div class="fw-semibold mb-2">' +
              child.name +
              '</div>' +
              '<span class="badge bg-success">' +
              coinBadge(child) +
              '</span>' +
              '<p class="text-secondary small mt-2 mb-0">' +
              (child.coinRewardMode === 'PER_KG'
                ? 'Toplama sonrası kilograma göre hesaplanır.'
                : 'Talep toplandığında hesabınıza eklenir.') +
              '</p>' +
              '</div></div></div>'
            );
          });
        });
        grid.innerHTML = cards.length
          ? cards.join('')
          : '<div class="col-12 text-secondary text-center py-4">Henüz atık çeşidi tanımlı değil.</div>';
      } catch (err) {
        grid.innerHTML =
          '<div class="col-12 text-danger text-center py-4">' +
          (err.message || 'Hata') +
          '</div>';
      }
    }

    document.addEventListener('DOMContentLoaded', function () {
      loadWallet();
      loadTypes();
    });
  })();
</script>

<%- include('../../layout/footer') %>
