<div class="row mb-6 g-6">
  <div class="col-xl-8 col-lg-6">
    <div class="bg-gradient-mixed p-8 py-10 rounded-3 p-lg-7">
      <!--heading-->
      <h1 class="fs-3">👋 Merhaba <%=user.name%>,</h1>
      <p class="mb-0">
        Kampüsümüzün geleceği için atıklarını takip et, geri dönüşüm istatistiklerini incele ve sürdürülebilir bir çevreye katkıda bulun.
      </p>
    </div>
  </div>
