<div class="map-container col-md-8 d-flex flex-column justify-content-between align-items-center">
  <div class="map-info col-md-3 d-flex flex-column gap-3 align-items-start">
    <select class="form-select" aria-label="Default select example" id="select">
      <option selected value="">Ege Üniversitesi</option>

      <% regions.forEach(function(item) { %>
        <option value="<%= item.region_id %>"><%= item.name %></option>
      <% }); %>

    </select>
  </div>
  <div class="col-md-12" id="map">

  </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script src="https://unpkg.com/@mapbox/leaflet-pip@latest/leaflet-pip.js"></script>

<script>
  // 1. HARİTA VE TEMEL DEĞİŞKENLER
  const map = L.map('map').setView([38.459, 27.228], 15);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; OpenStreetMap'
  }).addTo(map);

  let currentCampusLayer = null; // Poligonlar
  let binLayerGroup = L.layerGroup().addTo(map); // Mevcut Kovalar
  let tempMarker = null; // Yeni eklenen kova
  let detectedRegionId = null;

  // Zoom ölçeklendirme için baz değerler
  const baseZoom = 15;
  const baseSize = 35;

  // 2. DİNAMİK İKON HESAPLAMA
  function getDynamicIcon(zoom) {
    // Zoom seviyesine göre boyutu oranla (Min 15px, Max 60px sınırlamasıyla)
    let size = (zoom / baseZoom) * baseSize;
    size = Math.min(Math.max(size, 15), 60);

    return L.icon({
      iconUrl: '/assets/images/trash.jpg',
      iconSize: [size, size],
      iconAnchor: [size / 2, size],
      popupAnchor: [0, -size]
    });
  }

  // 3. MEVCUT KOVALARI YÜKLEME (HARİTA AÇILIŞINDA)
  async function loadExistingBins() {
    try {
      const response = await fetch('/api/bins');
      const bins = await response.json();
      const currentZoom = map.getZoom();

      binLayerGroup.clearLayers();

      bins.forEach(bin => {
        const marker = L.marker([bin.latitude, bin.longitude], {
          icon: getDynamicIcon(currentZoom)
        });

        marker.bindPopup(`
          <div class="text-center">
            <h6 class="mb-1">${bin.type}</h6>
            <p class="small mb-1">${bin.wasteCategory}</p>
            <div class="progress" style="height: 8px;">
              <div class="progress-bar ${bin.predictedFullness > 0.8 ? 'bg-danger' : 'bg-success'}"
                   style="width: ${bin.predictedFullness * 100}%"></div>
            </div>
            <small>%${(bin.predictedFullness * 100).toFixed(0)} Dolu</small>
          </div>
        `);
        marker.addTo(binLayerGroup);
      });
    } catch (err) {
      console.error("Kovalar yüklenemedi:", err);
    }
  }

  // 4. POLİGONLARI ÇİZME (KAMPÜS SINIRLARI)
  async function loadCampusAreas() {
    try {
      const response = await fetch('/api/regions/static');
      const result = await response.json();
      const geojsonData = result.features ? result : result.data;

      if (geojsonData) {
        currentCampusLayer = L.geoJSON(geojsonData, {
          style: { color: "#ff7800", weight: 2, fillOpacity: 0.1 }
        }).addTo(map);
        map.fitBounds(currentCampusLayer.getBounds());
      }
    } catch (err) {
      console.error("Poligonlar yüklenemedi:", err);
    }
  }

  // 5. ZOOM DEĞİŞTİĞİNDE İKONLARI YENİDEN BOYUTLANDIR
  map.on('zoomend', function() {
    const currentZoom = map.getZoom();
    const updatedIcon = getDynamicIcon(currentZoom);

    binLayerGroup.eachLayer(layer => {
      if (layer instanceof L.Marker) {
        layer.setIcon(updatedIcon);
      }
    });

    // Eğer o an yeni bir kova ekliyorsak onun ikonunu da büyüt/küçült
    if (tempMarker) tempMarker.setIcon(updatedIcon);
  });

  // 6. TIKLAYARAK YENİ KOVA EKLEME VE BÖLGE TESPİTİ
  map.on('click', function(e) {
    if (!currentCampusLayer) return;

    const match = leafletPip.pointInLayer([e.latlng.lng, e.latlng.lat], currentCampusLayer);

    if (match.length > 0) {
      const region = match[0].feature;
      detectedRegionId = region.id;

      document.getElementById('region-display').value = region.properties.name;
      document.getElementById('lat-input').value = e.latlng.lat.toFixed(6);
      document.getElementById('lng-input').value = e.latlng.lng.toFixed(6);

      if (tempMarker) {
        tempMarker.setLatLng(e.latlng);
      } else {
        tempMarker = L.marker(e.latlng, {
          draggable: true,
          icon: getDynamicIcon(map.getZoom())
        }).addTo(map);
      }
      document.getElementById('add-bin-panel').style.display = 'block';
    } else {
      alert("Lütfen bir kampüs bölgesi içine tıklayın!");
    }
  });

  // 7. KAYIT FONKSİYONU
  async function saveBinToServer() {
    const data = {
      latitude: parseFloat(document.getElementById('lat-input').value),
      longitude: parseFloat(document.getElementById('lng-input').value),
      wasteCategory: document.getElementById('waste-category').value,
      type: document.getElementById('bin-type').value,
      capacityVolume: parseFloat(document.getElementById('capacity').value),
      regionId: detectedRegionId
    };

    try {
      const res = await fetch('/api/bins/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      if (res.ok) {
        alert("Kova başarıyla eklendi!");
        location.reload();
      }
    } catch (err) {
      console.error("Kayıt hatası:", err);
    }
  }

  function cancelAdd() {
    if (tempMarker) map.removeLayer(tempMarker);
    tempMarker = null;
    document.getElementById('add-bin-panel').style.display = 'none';
  }

  // 8. BAŞLATICI
  window.onload = () => {
    loadCampusAreas();  // Poligonları çiz
    loadExistingBins(); // Mevcut kovaları getir

    // Kategori kısıtlama listener'ı (Önceki kodundan hatırla)
    document.getElementById('bin-type').addEventListener('change', function() {
      const cat = document.getElementById('waste-category');
      if (this.value !== 'WASTE_POINT') {
        cat.value = 'GENERAL';
        Array.from(cat.options).forEach(o => o.disabled = (o.value !== 'GENERAL'));
      } else {
        Array.from(cat.options).forEach(o => o.disabled = false);
      }
    });
  };
</script>
<%- include('../layout/footer') %>