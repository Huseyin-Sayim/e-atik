<%- include('../layout/header') %>
<% const isUserDashboard = user && user.role === 'USER'; %>
<div class="row mb-3 mt-6 g-6">
  <div class="col-xl-8 col-lg-6">
    <div class="bg-gradient-mixed p-8 py-10 rounded-3 p-lg-7">
      <!--heading-->
      <h1 class="fs-3">👋 Merhaba <%=user.name%>,</h1>
      <p class="mb-0">
        Kampüsümüzün geleceği için atıklarını takip et, geri dönüşüm istatistiklerini incele ve sürdürülebilir bir çevreye katkıda bulun.
      </p>
    </div>
  </div>
</div>
<%- include('../partials/employeeRegionAlerts') %>
<div class="row mb-2 mt-3">
  <div class="col-12">
    <h2 class="fs-5 mb-0">Geri dönüşüm özeti</h2>
    <p class="text-secondary small mb-0">
      <% if (isUserDashboard) { %>
        Kategori bazında kişisel toplama kayıtlarınız ve kampüs kovası hacimleri
      <% } else { %>
        Ana kategori ve alt atık çeşitlerine göre toplama özeti
      <% } %>
    </p>
  </div>
</div>

<div class="row mb-6 g-4">
  <% const statAccents = ['bg-warning-darker', 'bg-info-darker', 'bg-success-darker', 'bg-primary-darker', 'bg-danger-darker', 'bg-secondary']; %>
  <% const statsList = typeof recyclingStats !== 'undefined' ? recyclingStats : []; %>
  <% if (!statsList.length) { %>
  <div class="col-12">
    <p class="text-secondary mb-0">Henüz kategori verisi yok.</p>
  </div>
  <% } %>
  <% statsList.forEach(function(parent, index) { %>
  <div class="col-12">
    <div class="card card-lg border-0 shadow-sm">
      <div class="card-body">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-3">
          <div class="d-flex align-items-center gap-3">
            <div class="icon-shape icon-lg rounded-circle <%= statAccents[index % statAccents.length] %> d-flex align-items-center justify-content-center p-2">
              <img src="<%= parent.iconUrl %>" alt="" width="28" height="28" class="recycling-stat-icon">
            </div>
            <div>
              <h3 class="fs-6 fw-semibold mb-1"><%= parent.label %></h3>
              <p class="text-secondary small mb-0">Kampüs kovası: <strong><%= parent.formatted %></strong></p>
            </div>
          </div>
          <% if (parent.collectionCount > 0) { %>
          <div class="text-end">
            <div class="small text-secondary">Evden atık talebi</div>
            <div class="fw-semibold"><%= parent.formattedWeight %> · <%= parent.totalCoins %> coin</div>
            <div class="small text-secondary"><%= parent.collectionCount %> toplama</div>
          </div>
          <% } %>
        </div>
        <% if (parent.children && parent.children.length) { %>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
          <% parent.children.forEach(function(child) { %>
          <div class="col">
            <div class="border rounded-3 p-3 h-100 <%= child.collectionCount > 0 ? '' : 'opacity-75' %>">
              <div class="fw-semibold small mb-2"><%= child.name %></div>
              <% if (child.collectionCount > 0) { %>
              <div class="fs-5 fw-bold mb-1"><%= child.formattedWeight %></div>
              <div class="small text-secondary mb-1"><%= child.totalCoins %> coin kazanıldı</div>
              <div class="small text-secondary"><%= child.collectionCount %> toplama</div>
              <% } else { %>
              <div class="small text-secondary mb-0">Henüz toplama yok</div>
              <% if (child.coinRewardMode === 'PER_KG') { %>
              <div class="badge bg-light text-dark mt-2"><%= child.coinRewardValue %> coin / kg</div>
              <% } else if (child.coinRewardValue > 0) { %>
              <div class="badge bg-light text-dark mt-2"><%= child.coinRewardValue %> coin / toplama</div>
              <% } %>
              <% } %>
            </div>
          </div>
          <% }); %>
        </div>
        <% } %>
      </div>
    </div>
  </div>
  <% }); %>
</div>

<style>
  .recycling-stat-icon {
    width: 28px;
    height: 28px;
    object-fit: contain;
  }
</style>

<% if (isUserDashboard) { %>
<div class="row mb-6">
  <div class="col-12 col-lg-6">
    <div class="card card-lg bg-gradient-mixed border-0">
      <div class="card-body p-6 d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-4">
        <div>
          <h3 class="fs-5 mb-2">Kişisel geri dönüşümünüz</h3>
          <p class="text-secondary small mb-0">Geri dönüştürdüğünüz atık miktarını kategori bazında takip edin.</p>
        </div>
        <a href="/user/my-recycling" class="btn btn-primary flex-shrink-0">Geri dönüşümümü gör</a>
      </div>
    </div>
  </div>
</div>
<% } %>

<div class="map-container col-md-8 d-flex flex-column justify-content-between align-items-center">
  <div class="map-info col-md-3 d-flex flex-column gap-3 align-items-start">
    <select class="form-select" aria-label="Default select example" id="select">
      <option selected value="">Ege Üniversitesi</option>

      <% regions.forEach(function(item) { %>
        <option value="<%= item.region_id %>"><%= item.name %></option>
      <% }); %>

    </select>
  </div>
  <div class="col-md-12" id="map"></div>

  <div class="map-bin-legend d-flex flex-wrap gap-3 align-items-center mt-2 mb-3" id="map-bin-legend"></div>
</div>

<style>
  .map-bin-legend { font-size: 0.875rem; }
  .map-bin-legend__group { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; }
  .map-bin-legend__item { display: inline-flex; align-items: center; gap: 0.35rem; }
  .map-bin-legend__item img { width: 20px; height: 20px; object-fit: contain; }
  .leaflet-marker-icon { image-rendering: -webkit-optimize-contrast; image-rendering: crisp-edges; }
</style>

<link rel="stylesheet" href="/assets/css/map-pin-marker.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script src="/assets/js/map/binMapIcons.js"></script>
<script src="https://unpkg.com/@mapbox/leaflet-pip@latest/leaflet-pip.js"></script>

<script>
  const DASHBOARD_USER_ROLE = '<%= user.role %>';
  const map = L.map('map').setView([38.459, 27.228], 15);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; OpenStreetMap'
  }).addTo(map);

  let currentCampusLayer = null;
  let selectedRegionLayer = null;
  let binLayerGroup = L.layerGroup().addTo(map);
  let campusGeoJson = null;

  const MAP_ICON_OPTS = { baseZoom: 15, baseSize: 22 };

  function renderMapLegend() {
    const el = document.getElementById('map-bin-legend');
    if (!el) return;
    el.innerHTML = renderMapLegendHtml();
  }

  function markerIconOptions(bin) {
    return { ...MAP_ICON_OPTS, wasteCategory: bin.wasteCategory };
  }

  function formatWasteTypeLabel(req) {
    if (!req.wasteType) return 'Evsel Atık';
    if (typeof req.wasteType === 'string') {
      if (req.wasteType === 'DOMESTIC') return 'Organik Atık';
      if (req.wasteType === 'ELECTRONIC') return 'Elektronik Atık';
      if (req.wasteType === 'PLASTIC') return 'Ambalaj Atığı';
      return req.wasteType;
    }
    const parent = req.wasteType.parent ? req.wasteType.parent.name + ' — ' : '';
    return parent + (req.wasteType.name || 'Evsel Atık');
  }

  function binFullnessRatio(bin) {
    const v = Number(bin?.predictedFullness ?? 0);
    if (!Number.isFinite(v) || v <= 0) return 0;
    return v > 1 ? Math.min(1, v / 100) : Math.min(1, v);
  }

  function binFullnessPercent(bin) {
    return Math.round(binFullnessRatio(bin) * 100);
  }

  async function loadExistingBins() {
    try {
      // 3a. Atık Kutularını (Bins) Yükle
      const response = await fetch('/api/bins');
      const bins = await response.json();
      const currentZoom = map.getZoom();

      binLayerGroup.clearLayers();

      bins.forEach((bin) => {
        const marker = L.marker([bin.latitude, bin.longitude], {
          icon: getBinIcon(bin.type, currentZoom, markerIconOptions(bin)),
        });

        marker.binId = bin.id;
        marker.binType = bin.type;
        marker.binWasteCategory = bin.wasteCategory;
        marker.binRecord = bin;

        marker.bindPopup(`
          <div class="text-center">
            <h6 class="mb-1">${getBinTypeLabel(bin.type, bin.wasteCategory)}</h6>
            <p class="small mb-1">${bin.type === 'WASTE_POINT' ? getWasteCategoryLabel(bin.wasteCategory) : bin.wasteCategory}</p>
            <div class="progress" style="height: 8px;">
              <div class="progress-bar ${binFullnessRatio(bin) > 0.8 ? 'bg-danger' : 'bg-success'}"
                   style="width: ${binFullnessPercent(bin)}%"></div>
            </div>
            <small>%${binFullnessPercent(bin)} Dolu</small>
          </div>
        `);
        marker.addTo(binLayerGroup);
      });

      // 3b. Evsel Atık Taleplerini (Waste Requests) Yükle
      if (['ADMIN', 'BOSS', 'EMPLOYEE'].includes(DASHBOARD_USER_ROLE)) {
        try {
          const reqResponse = await fetch('/api/waste-requests', { credentials: 'same-origin' });
          if (reqResponse.ok) {
            const reqResult = await reqResponse.json();
            const requests = Array.isArray(reqResult) ? reqResult : (reqResult.data || []);

            const activeRequests = requests.filter(r => r.status === 'PENDING' || r.status === 'ON_ROUTE');

            activeRequests.forEach(req => {
              const catName = formatWasteTypeLabel(req);

          const requestHtml = `
            <div class="custom-request-pin" style="display: flex; flex-direction: column; align-items: center; justify-content: center; width: 36px; height: 36px; background-color: #2563eb; border: 3px solid #fff; border-radius: 50%; box-shadow: 0 2px 8px rgba(37, 99, 235, 0.5); color: #fff;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: white;">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
            </div>
          `;
          
          const requestIcon = L.divIcon({
            className: 'custom-web-request-marker',
            html: requestHtml,
            iconSize: [36, 36],
            iconAnchor: [18, 36],
            popupAnchor: [0, -36]
          });

          const marker = L.marker([req.latitude, req.longitude], {
            icon: requestIcon
          });

          marker.bindPopup(`
            <div class="text-center" style="min-width: 180px;">
              <span class="badge bg-primary mb-2 text-white" style="font-size: 11px; padding: 4px 8px;">EVSEL ATIK TALEBİ</span>
              <h6 class="mb-1">${catName}</h6>
              <p class="small mb-1"><b>Talep Eden:</b> ${req.user ? req.user.name + ' ' + (req.user.surname || '') : 'Vatandaş'}</p>
              <p class="small mb-2"><b>Açıklama:</b> ${req.note || 'Yok'}</p>
              <div class="d-flex justify-content-between align-items-center mt-2">
                <span class="badge ${req.status === 'PENDING' ? 'bg-warning text-dark' : 'bg-info text-white'}">${req.status === 'PENDING' ? 'Beklemede' : 'Yolda'}</span>
                <button class="btn btn-xs btn-success py-1 px-2 text-white" style="font-size: 11px;" onclick="completeRequestFromWeb('${req.id}')">Topla</button>
              </div>
            </div>
          `);
          marker.addTo(binLayerGroup);
            });
          }
        } catch (reqErr) {
          console.error("Evsel atık talepleri yüklenemedi:", reqErr);
        }
      }

    } catch (err) {
      console.error("Kovalar yüklenemedi:", err);
    }
  }

  // 4. POLİGONLARI ÇİZME (KAMPÜS SINIRLARI)
  async function loadCampusAreas() {
    try {
      const response = await fetch('/api/regions/static');
      const result = await response.json();
      const geojsonData = result.features ? result : result.data;

      if (geojsonData) {
        campusGeoJson = geojsonData;
        currentCampusLayer = L.geoJSON(geojsonData, {
          style: { color: "#ff7800", weight: 2, fillOpacity: 0.1 }
        }).addTo(map);
        map.fitBounds(currentCampusLayer.getBounds());
      }
    } catch (err) {
      console.error("Poligonlar yüklenemedi:", err);
    }
  }

  function clearSelectedRegionLayer() {
    if (selectedRegionLayer) {
      map.removeLayer(selectedRegionLayer);
      selectedRegionLayer = null;
    }
  }

  function zoomToRegionFeature(feature) {
    if (!feature || !feature.geometry) return;
    clearSelectedRegionLayer();
    selectedRegionLayer = L.geoJSON(feature, {
      style: { color: "#00a76f", weight: 3, fillOpacity: 0.25, fillColor: "#00a76f" }
    }).addTo(map);
    map.fitBounds(selectedRegionLayer.getBounds(), { padding: [40, 40], maxZoom: 17 });
  }

  function zoomToRegionById(regionId) {
    if (!regionId) {
      clearSelectedRegionLayer();
      if (currentCampusLayer) {
        map.fitBounds(currentCampusLayer.getBounds(), { padding: [30, 30] });
      }
      return;
    }

    if (campusGeoJson && campusGeoJson.features) {
      const feature = campusGeoJson.features.find((f) => f.id === regionId);
      if (feature) {
        zoomToRegionFeature(feature);
        return;
      }
    }

    fetch('/api/regions/static/' + encodeURIComponent(regionId))
      .then((res) => res.json())
      .then((result) => {
        const feature = result.data;
        if (feature && feature.geometry) {
          zoomToRegionFeature(feature);
        }
      })
      .catch((err) => console.error('Bölge yüklenemedi:', err));
  }

  map.on('zoomend', function () {
    const currentZoom = map.getZoom();
    binLayerGroup.eachLayer((layer) => {
      if (layer instanceof L.Marker && layer.binType) {
        layer.setIcon(
          getBinIcon(layer.binType, currentZoom, {
            ...MAP_ICON_OPTS,
            wasteCategory: layer.binWasteCategory,
          })
        );
      }
    });
  });

  // 6. BÖLGE SEÇİMİNDE ZOOM
  document.getElementById('select').addEventListener('change', function () {
    zoomToRegionById(this.value);
  });

  // 7. KAYIT FONKSİYONU
  async function saveBinToServer() {
    const data = {
      latitude: parseFloat(document.getElementById('lat-input').value),
      longitude: parseFloat(document.getElementById('lng-input').value),
      wasteCategory: document.getElementById('waste-category').value,
      type: document.getElementById('bin-type').value,
      capacityVolume: parseFloat(document.getElementById('capacity').value),
      regionId: detectedRegionId
    };

    try {
      const res = await fetch('/api/bins/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      if (res.ok) {
        alert("Kova başarıyla eklendi!");
        location.reload();
      }
    } catch (err) {
      console.error("Kayıt hatası:", err);
    }
  }

  function cancelAdd() {
    if (tempMarker) map.removeLayer(tempMarker);
    tempMarker = null;
    document.getElementById('add-bin-panel').style.display = 'none';
  }

  // 9. WEB ÜZERİNDEN EVSEL ATIK TALEBİNİ TAMAMLAMA (TOPLAMA)
  async function completeRequestFromWeb(requestId) {
    if (!confirm("Bu evsel atık talebini toplandı olarak işaretlemek istediğinize emin misiniz?")) return;
    try {
      const res = await fetch(`/api/waste-requests/${requestId}`, {
        method: 'PATCH',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: 'COLLECTED' })
      });
      if (res.ok) {
        alert("Talep başarıyla tamamlandı!");
        loadExistingBins(); // Haritayı yeniden yükle
      } else {
        const json = await res.json();
        alert("Hata: " + (json.message || "Talep güncellenemedi."));
      }
    } catch (err) {
      console.error("Talep tamamlama hatası:", err);
      alert("Sunucuya bağlanırken bir hata oluştu.");
    }
  }

  // 10. WEBSOCKET GERÇEK ZAMANLI HARİTA GÜNCELLEME
  const wsUrl = window.location.protocol === 'https:' 
    ? 'wss://' + window.location.host 
    : 'ws://' + window.location.host;
  const ws = new WebSocket(wsUrl);
  ws.onopen = () => console.log('✅ WebSocket Bağlantısı Kuruldu (Web Dashboard)');
  ws.onmessage = (event) => {
    try {
      const payload = JSON.parse(event.data);
      if (
        payload.type === 'wasteRequestCreated' || 
        payload.type === 'wasteRequestStatusChanged' || 
        payload.type === 'binCreated' || 
        payload.type === 'binUpdated' || 
        payload.type === 'binDeleted'
      ) {
        console.log('🔄 Harita güncelleme bildirimi algılandı, veriler yenileniyor...');
        loadExistingBins();
      }
    } catch (err) {
      // Yoksay
    }
  };
  ws.onerror = (e) => console.warn('WebSocket Hatası (Web Dashboard):', e);

  // 8. BAŞLATICI
  window.onload = () => {
    renderMapLegend();
    loadCampusAreas();
    loadExistingBins();
    initFullnessSocket();
  };
</script>
<script src="/socket.io/socket.io.js"></script>
<script src="/assets/js/socketClient.js"></script>
<%- include('../layout/footer') %>