                class="icon icon-tabler icons-tabler-outline icon-tabler-map-pin">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" />
                <path d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0z" />
              </svg>
            </span>
            <span class="text">Bölge seçimi</span>
          </a>
        </li>
        <% if (typeof user !== 'undefined' && user && user.role === 'ADMIN') { %>
        <li class="nav-item">
          <a class="nav-link" href="/admin/employee-tracking">
            <span class="nav-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-map-2">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M12 18.5l-3 -1.5l-6 3v-13l6 -3l6 3l6 -3v7.5" />
                <path d="M9 4v13" />
                <path d="M15 7v5.5" />
              </svg>
            </span>
            <span class="text">Çalışan konum takibi</span>
          </a>
        </li>
        <% } %>
        <% if (typeof user !== 'undefined' && user && user.role === 'EMPLOYEE') { %>
        <li class="nav-item">
          <a class="nav-link" href="/employee/my-route">
            <span class="nav-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-route">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M3 19a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
                <path d="M19 7a2 2 0 1 0 2 -2a2 2 0 1 0 -2 2" />
                <path d="M11 19h6.5a1.5 1.5 0 0 0 1.5 -1.5v-15a1.5 1.5 0 0 0 -1.5 -1.5h-9a1.5 1.5 0 0 0 -1.5 1.5v6.5" />
                <path d="M5 12l14 0" />
              </svg>
            </span>
            <span class="text">Benim Rotam</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/employee/work-region">
            <span class="nav-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-briefcase">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M3 7m0 2a2 2 0 0 0 2 2h14a2 2 0 0 0 2 -2v-9a2 2 0 0 0 -2 -2h-14a2 2 0 0 0 -2 2v9z" />
                <path d="M8 7v-2a2 2 0 0 1 2 -2h4a2 2 0 0 1 2 2v2" />
                <path d="M12 12l0 .01" />
                <path d="M3 13l18 0" />
              </svg>
            </span>
            <span class="text">Çalışma bölgesi seç</span>
          </a>
        </li>
        <% } %>
        <% } %>
      </ul>
    </div>

    <div class="offcanvasNav offcanvas offcanvas-start" tabindex="-1" id="offcanvasExample"
      aria-labelledby="offcanvasExampleLabel">
      <div class="offcanvas-header">
        <a class="d-flex align-items-center gap-2" href="/dashboard">
          <img src="/assets/images/brand/logo/logo-icon.svg" alt="E-Atık" />
          <span class="fw-bold fs-4 site-logo-text">E-Atık</span>
        </a>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Kapat"></button>
      </div>
      <div class="offcanvas-body p-0">
        <ul class="navbar-nav flex-column">
          <li class="nav-item">
            <a class="nav-link" href="/dashboard">
              <span class="nav-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                  class="icon icon-tabler icons-tabler-outline icon-tabler-home">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M5 12l-2 0l9 -9l9 9l-2 0" />
                  <path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7" />
                </svg>
              </span>
              <span class="text">Anasayfa</span>
            </a>
          </li>
          <% if (typeof user !== 'undefined' && user && user.role === 'USER') { %>
          <li class="nav-item">
            <a class="nav-link" href="/user/my-recycling">
              <span class="nav-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                  class="icon icon-tabler icons-tabler-outline icon-tabler-recycle">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M12 17l-2 2m2 -2l2 2m-2 -2v-5" />
                  <path d="M7 12a5 5 0 0 1 5 -5h3" />
                  <path d="M17 12a5 5 0 0 1 -5 5h-3" />
                </svg>
              </span>
              <span class="text">Geri dönüşümüm</span>
            </a>
          </li>
          <% } else { %>
          <% if (typeof user !== 'undefined' && user && (user.role === 'ADMIN' || user.role === 'BOSS')) { %>
          <li class="nav-item">
            <a class="nav-link" href="/bin/create">
              <span class="nav-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                  class="icon icon-tabler icons-tabler-outline icon-tabler-trash">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M4 7l16 0" />
                  <path d="M10 11l0 6" />
                  <path d="M14 11l0 6" />
                  <path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12" />
                  <path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" />
                </svg>
              </span>
              <span class="text">Çöp kovası yönetimi</span>
            </a>
          </li>
          <% } %>
          <li class="nav-item">
            <a class="nav-link" href="/region/create">
              <span class="nav-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                  class="icon icon-tabler icons-tabler-outline icon-tabler-map-pin">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" />
                  <path d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0z" />
                </svg>
              </span>
              <span class="text">Bölge seçimi</span>
            </a>
          </li>
          <% if (typeof user !== 'undefined' && user && user.role === 'ADMIN') { %>
          <li class="nav-item">
            <a class="nav-link" href="/admin/employee-tracking">
              <span class="nav-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                  class="icon icon-tabler icons-tabler-outline icon-tabler-map-2">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M12 18.5l-3 -1.5l-6 3v-13l6 -3l6 3l6 -3v7.5" />
                  <path d="M9 4v13" />
                  <path d="M15 7v5.5" />
                </svg>
              </span>
              <span class="text">Çalışan konum takibi</span>
            </a>
          </li>
          <% } %>
          <% if (typeof user !== 'undefined' && user && user.role === 'EMPLOYEE') { %>
          <li class="nav-item">
            <a class="nav-link" href="/employee/my-route">
              <span class="nav-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                  class="icon icon-tabler icons-tabler-outline icon-tabler-route">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M3 19a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
                  <path d="M19 7a2 2 0 1 0 2 -2a2 2 0 1 0 -2 2" />
                  <path d="M11 19h6.5a1.5 1.5 0 0 0 1.5 -1.5v-15a1.5 1.5 0 0 0 -1.5 -1.5h-9a1.5 1.5 0 0 0 -1.5 1.5v6.5" />
                  <path d="M5 12l14 0" />
                </svg>
              </span>
              <span class="text">Benim Rotam</span>
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/employee/work-region">
              <span class="nav-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
