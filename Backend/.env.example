# Veritabani (Docker db servisi)
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=eatik

# Uygulama
PORT=2001
DATABASE_URL=postgres://postgres:password@db:5432/eatik

# JWT (gelistirme icin ornek degerler)
ACCESS_SECRET_KEY=dev-access-secret-change-me
REFRESH_SECRET_KEY=dev-refresh-secret-change-me

# Opsiyonel
SEED_PASSWORD=password

# Benim Rotam demo baslangic (EMPLOYEE)
ROUTE_DEMO_START_LAT=38.458919
ROUTE_DEMO_START_LNG=27.227533
# Benim Rotam — OSRM yol geometrisi (production'da kendi sunucunuz önerilir)
OSRM_URL=https://router.project-osrm.org
OSRM_TIMEOUT_MS=15000

# Dinamik rota aday filtresi
ROUTE_MIN_FULLNESS=0.05
ROUTE_RELATIVE_TOP_N=5
ROUTE_RELATIVE_MIN=0.02

# Doluluk WebSocket yayını
FULLNESS_POLL_INTERVAL_MS=60000
FULLNESS_EMIT_DELTA=0.01
